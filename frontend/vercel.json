{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/umami/:path*",
      "destination": "https://linkguessr.duckdns.org/umami/:path*"
    },
    {
      "source": "/((?!api/|v1/|umami/).*)",
      "destination": "/index.html"
    }
  ]
}
