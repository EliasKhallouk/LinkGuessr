{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/umami",
      "destination": "https://linkguessr.duckdns.org/umami"
    },
    {
      "source": "/umami/:path*",
      "destination": "https://linkguessr.duckdns.org/umami/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/proxy?path=sitemap.xml"
    },
    {
      "source": "/sitemap-:part.xml",
      "destination": "/api/proxy?path=sitemap-:part.xml"
    },
    {
      "source": "/((?!api/|v1/|umami/|sitemap).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/umami/",
      "destination": "/umami",
      "permanent": false
    }
  ]
}
